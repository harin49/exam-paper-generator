{
  "description": "exam-papers: record the teacher's typed approvals and decisions, keep everyone else from writing them, and limit what the blind solver and the writer can see.",
  "hooks": {
    "UserPromptExpansion": [
      { "hooks": [ { "type": "command", "command": "python3", "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/approve.py"] } ] }
    ],
    "PreToolUse": [
      { "matcher": "Read|Grep|Glob|Write|Edit|MultiEdit|NotebookEdit|Bash",
        "hooks": [ { "type": "command", "command": "python3", "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/guard.py"] } ] }
    ]
  }
}
