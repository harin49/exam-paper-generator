{
  "description": "exam-papers: record the teacher's typed approvals, and keep everyone else out of approvals.json (D6).",
  "hooks": {
    "UserPromptExpansion": [
      { "hooks": [ { "type": "command", "command": "python3", "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/approve.py"] } ] }
    ],
    "PreToolUse": [
      { "matcher": "Write|Edit|MultiEdit|NotebookEdit|Bash",
        "hooks": [ { "type": "command", "command": "python3", "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/approve.py"] } ] }
    ]
  }
}
